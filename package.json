{
  "name": "sqoor-iraq-offline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fonts": "node scripts/download-fonts.mjs",
    "build:tiles": "node scripts/generate-iraq-tiles.mjs",
    "build:web": "node scripts/prepare-web.mjs",
    "android:add": "node scripts/ensure-android.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "build:android": "npm run build:fonts && npm run build:tiles && npm run build:web && npm run android:add && npm run android:prepare && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@mapbox/mapbox-gl-rtl-text": "0.2.3",
    "lucide": "^0.468.0",
    "maplibre-gl": "5.24.0",
    "pmtiles": "^3.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
