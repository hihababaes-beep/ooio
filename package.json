{
  "name": "sqoor-iraq-offline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:tiles": "node scripts/generate-iraq-tiles.mjs",
    "prepare:web": "node scripts/prepare-web.mjs && node scripts/download-fonts.mjs",
    "build:android": "npm run generate:tiles && npm run prepare:web && cap add android && node scripts/prepare-android.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@mapbox/mapbox-gl-rtl-text": "0.2.3",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
